# Copy to .env.local (local) or add in your host's dashboard (Vercel > Settings > Environment Variables).

# Live website address, no trailing slash. Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://sunyaverse.com.au

# Cal.com event for the free consultation: the part after cal.com/ in your booking link.
# Example: https://cal.com/sunyaverse/free-consultation  ->  sunyaverse/free-consultation
NEXT_PUBLIC_CAL_LINK=sunyaverse/free-consultation

# Contact form email delivery (Resend, free tier: https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Sunyaverse website <website@sunyaverse.com.au>"
CONTACT_TO_EMAIL=hello@sunyaverse.com.au
CAREERS_TO_EMAIL=careers@sunyaverse.com.au
